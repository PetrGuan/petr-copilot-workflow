#!/usr/bin/env bash
set -euo pipefail

GITHUB_ROOT="${COPILOT_WORKFLOW_GITHUB_ROOT:-$HOME/Documents/GitHub}"
WORKFLOW_ROOT="${COPILOT_WORKFLOW_ROOT:-$GITHUB_ROOT/.copilot-workflow}"
DEFAULT_INTERVAL="${COPILOT_WORKFLOW_INTERVAL:-60}"
ARCHITECT_MODEL="${COPILOT_WORKFLOW_ARCHITECT_MODEL:-gpt-5.5}"
IMPLEMENTER_MODEL="${COPILOT_WORKFLOW_IMPLEMENTER_MODEL:-gpt-5.3-codex}"
REVIEWER_MODEL="${COPILOT_WORKFLOW_REVIEWER_MODEL:-gpt-5.5}"
COPILOT_BIN="${COPILOT_WORKFLOW_COPILOT_BIN:-copilot}"
COPILOT_FLAGS="${COPILOT_WORKFLOW_COPILOT_FLAGS:---allow-all}"
INTERACTIVE_FLAGS="${COPILOT_WORKFLOW_INTERACTIVE_FLAGS:-}"

PROJECT_ROOT=""
PROJECT_ID=""
PROJECT_DIR=""

usage() {
  cat <<'USAGE'
Usage:
  copilot-flow init
  copilot-flow new "request text"
  copilot-flow status
  copilot-flow where
  copilot-flow set-status <status>
  copilot-flow refresh
  copilot-flow start <architect|implementer|reviewer>
  copilot-flow run <architect|implementer|reviewer>
  copilot-flow watch <architect|implementer|reviewer> [seconds]
  copilot-flow prompts

Environment:
  COPILOT_WORKFLOW_GITHUB_ROOT       Default: $HOME/Documents/GitHub
  COPILOT_WORKFLOW_ROOT              Default: $GITHUB_ROOT/.copilot-workflow
  COPILOT_WORKFLOW_INTERVAL          Default: 60
  COPILOT_WORKFLOW_ARCHITECT_MODEL   Default: gpt-5.5
  COPILOT_WORKFLOW_IMPLEMENTER_MODEL Default: gpt-5.3-codex
  COPILOT_WORKFLOW_REVIEWER_MODEL    Default: gpt-5.5
  COPILOT_WORKFLOW_COPILOT_FLAGS     Default: --allow-all
  COPILOT_WORKFLOW_INTERACTIVE_FLAGS Default: empty
USAGE
}

die() {
  printf 'copilot-flow: %s\n' "$*" >&2
  exit 1
}

abspath_dir() {
  cd "$1" 2>/dev/null && pwd -P
}

is_under() {
  case "$1/" in
    "$2/"*) return 0 ;;
    *) return 1 ;;
  esac
}

project_root_for() {
  local start="${1:-$PWD}"
  local abs root rel first

  abs="$(abspath_dir "$start")" || die "cannot access directory: $start"
  GITHUB_ROOT="$(abspath_dir "$GITHUB_ROOT")" || die "cannot access GitHub root: $GITHUB_ROOT"

  if root="$(git -C "$abs" rev-parse --show-toplevel 2>/dev/null)"; then
    root="$(abspath_dir "$root")"
    if is_under "$root" "$GITHUB_ROOT"; then
      printf '%s\n' "$root"
      return
    fi
  fi

  if ! is_under "$abs" "$GITHUB_ROOT"; then
    die "run this from a project under $GITHUB_ROOT"
  fi

  if [ "$abs" = "$GITHUB_ROOT" ]; then
    printf '%s\n' "$GITHUB_ROOT"
    return
  fi

  rel="${abs#$GITHUB_ROOT/}"
  first="${rel%%/*}"
  printf '%s\n' "$GITHUB_ROOT/$first"
}

project_id_for() {
  local root="$1"
  local rel
  rel="${root#$GITHUB_ROOT/}"
  if [ -z "$rel" ] || [ "$rel" = "$root" ]; then
    rel="github-root"
  fi
  rel="${rel//\//__}"
  printf '%s' "$rel" | sed 's#[^A-Za-z0-9._-]#_#g'
}

status_value() {
  local dir="$1"
  if [ ! -f "$dir/STATUS.md" ]; then
    printf 'missing\n'
    return
  fi
  sed -n '1{s/[[:space:]]//g;p;q;}' "$dir/STATUS.md"
}

valid_status() {
  case "$1" in
    idle|new-request|planning|ready-for-implementation|implementing|ready-for-review|reviewing|approved|changes-requested|blocked|failed-architect|failed-implementer|failed-reviewer)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

html_escape_stream() {
  awk '{
    gsub(/&/, "\\&amp;");
    gsub(/</, "\\&lt;");
    gsub(/>/, "\\&gt;");
    print;
  }'
}

html_escape_value() {
  printf '%s' "$1" | html_escape_stream
}

append_log() {
  local dir="$1"
  local old_status="$2"
  local new_status="$3"
  local event="${4:-status}"
  local project="${PROJECT_ID:-$(basename "$dir")}"

  [ -f "$dir/LOG.md" ] || {
    printf '# Workflow Log\n\nAppend-only workflow events generated by `copilot-flow`.\n\n' > "$dir/LOG.md"
  }

  {
    printf '## [%s] %s | %s -> %s\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$event" "$old_status" "$new_status"
    printf -- '- project: `%s`\n' "$project"
    printf -- '- workflow_dir: `%s`\n\n' "$dir"
  } >> "$dir/LOG.md"
}

update_index() {
  local dir="$1"
  local status
  status="$(status_value "$dir")"

  cat > "$dir/INDEX.md" <<EOF
# Workflow Index

This file is generated by \`copilot-flow\`. Do not edit it manually.

## Current state

- Project: \`${PROJECT_ID:-$(basename "$dir")}\`
- Project root: \`${PROJECT_ROOT:-unknown}\`
- Workflow directory: \`$dir\`
- Status: \`$status\`
- Updated: \`$(date -u +%Y-%m-%dT%H:%M:%SZ)\`

## Workflow files

- [REQUEST.md](REQUEST.md) - user request
- [PLAN.md](PLAN.md) - architect plan
- [IMPLEMENTATION.md](IMPLEMENTATION.md) - implementer notes
- [REVIEW.md](REVIEW.md) - reviewer findings
- [STATUS.md](STATUS.md) - current state
- [LOG.md](LOG.md) - chronological workflow log
- [DASHBOARD.html](DASHBOARD.html) - generated visual dashboard

## Status flow

\`\`\`text
idle -> new-request -> planning -> ready-for-implementation -> implementing -> ready-for-review -> reviewing -> approved
ready-for-review -> reviewing -> changes-requested -> implementing -> ready-for-review
\`\`\`

EOF
}

render_file_section() {
  local title="$1"
  local file="$2"

  printf '<section class="card">\n'
  printf '<h2>%s</h2>\n' "$(html_escape_value "$title")"
  printf '<pre>'
  if [ -f "$file" ]; then
    html_escape_stream < "$file"
  else
    printf 'Missing file: %s\n' "$(html_escape_value "$file")"
  fi
  printf '</pre>\n'
  printf '</section>\n'
}

render_dashboard() {
  local dir="$1"
  local tmp="$dir/DASHBOARD.html.tmp"
  local status
  status="$(status_value "$dir")"

  {
    cat <<EOF
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Copilot Workflow Dashboard</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #0f1115;
      --card: #171a21;
      --text: #e6edf3;
      --muted: #9aa4b2;
      --accent: #7c3aed;
      --border: #2b303b;
    }
    body {
      margin: 0;
      font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--text);
    }
    header {
      padding: 32px;
      border-bottom: 1px solid var(--border);
      background: linear-gradient(135deg, rgba(124, 58, 237, 0.22), transparent 55%);
    }
    h1, h2 {
      margin: 0 0 12px;
    }
    .meta {
      color: var(--muted);
      display: grid;
      gap: 4px;
    }
    main {
      padding: 24px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 16px;
    }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 18px;
      overflow: hidden;
    }
    pre {
      white-space: pre-wrap;
      word-break: break-word;
      margin: 0;
      color: var(--text);
    }
    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 999px;
      background: var(--accent);
      color: white;
      font-weight: 600;
    }
  </style>
</head>
<body>
<!-- AUTOGENERATED by copilot-flow refresh. Do not edit directly. -->
<header>
  <h1>Copilot Workflow Dashboard</h1>
  <div class="meta">
    <div>Status: <span class="badge">$(html_escape_value "$status")</span></div>
    <div>Project: <code>$(html_escape_value "${PROJECT_ID:-$(basename "$dir")}")</code></div>
    <div>Project root: <code>$(html_escape_value "${PROJECT_ROOT:-unknown}")</code></div>
    <div>Workflow directory: <code>$(html_escape_value "$dir")</code></div>
    <div>Updated: <code>$(date -u +%Y-%m-%dT%H:%M:%SZ)</code></div>
  </div>
</header>
<main>
EOF
    render_file_section "Request" "$dir/REQUEST.md"
    render_file_section "Plan" "$dir/PLAN.md"
    render_file_section "Implementation" "$dir/IMPLEMENTATION.md"
    render_file_section "Review" "$dir/REVIEW.md"
    render_file_section "Log" "$dir/LOG.md"
    cat <<'EOF'
</main>
</body>
</html>
EOF
  } > "$tmp"

  mv "$tmp" "$dir/DASHBOARD.html"
}

refresh_generated() {
  local dir="$1"
  update_index "$dir"
  render_dashboard "$dir"
}

set_status() {
  local dir="$1"
  local status="$2"
  local event="${3:-status}"
  local old_status="missing"

  valid_status "$status" || die "invalid status: $status"

  if [ -f "$dir/STATUS.md" ]; then
    old_status="$(status_value "$dir")"
  fi

  {
    printf '%s\n\n' "$status"
    printf 'updated_at: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$dir/STATUS.md"

  if [ "$old_status" != "$status" ] || [ "$event" != "status" ]; then
    append_log "$dir" "$old_status" "$status" "$event"
  fi

  refresh_generated "$dir"
}

ensure_project() {
  PROJECT_ROOT="$(project_root_for "$PWD")"
  PROJECT_ID="$(project_id_for "$PROJECT_ROOT")"
  PROJECT_DIR="$WORKFLOW_ROOT/projects/$PROJECT_ID"

  mkdir -p "$PROJECT_DIR"

  for file in REQUEST.md PLAN.md IMPLEMENTATION.md REVIEW.md LOG.md INDEX.md; do
    if [ ! -f "$PROJECT_DIR/$file" ]; then
      cp "$WORKFLOW_ROOT/templates/$file" "$PROJECT_DIR/$file"
    fi
  done

  {
    printf 'project_id: %s\n' "$PROJECT_ID"
    printf 'project_root: %s\n' "$PROJECT_ROOT"
    printf 'workflow_dir: %s\n' "$PROJECT_DIR"
  } > "$PROJECT_DIR/PROJECT.md"

  if [ ! -f "$PROJECT_DIR/STATUS.md" ]; then
    set_status "$PROJECT_DIR" "idle" "init"
  else
    refresh_generated "$PROJECT_DIR"
  fi
}

new_request() {
  ensure_project
  local request="$*"
  if [ -z "$request" ] && [ ! -t 0 ]; then
    request="$(cat)"
  fi
  [ -n "$request" ] || die "request text is required"

  {
    printf '# Request\n\n'
    printf '%s\n\n' "$request"
    printf '## Submitted\n\n'
    printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$PROJECT_DIR/REQUEST.md"

  cp "$WORKFLOW_ROOT/templates/PLAN.md" "$PROJECT_DIR/PLAN.md"
  cp "$WORKFLOW_ROOT/templates/IMPLEMENTATION.md" "$PROJECT_DIR/IMPLEMENTATION.md"
  cp "$WORKFLOW_ROOT/templates/REVIEW.md" "$PROJECT_DIR/REVIEW.md"
  set_status "$PROJECT_DIR" "new-request" "request"

  printf 'Request queued for %s\n' "$PROJECT_ID"
  printf 'Workbench: %s\n' "$PROJECT_DIR"
}

role_model() {
  case "$1" in
    architect) printf '%s\n' "$ARCHITECT_MODEL" ;;
    implementer) printf '%s\n' "$IMPLEMENTER_MODEL" ;;
    reviewer) printf '%s\n' "$REVIEWER_MODEL" ;;
    *) die "unknown role: $1" ;;
  esac
}

role_start_status() {
  case "$1" in
    architect) printf 'planning\n' ;;
    implementer) printf 'implementing\n' ;;
    reviewer) printf 'reviewing\n' ;;
    *) die "unknown role: $1" ;;
  esac
}

role_failure_status() {
  case "$1" in
    architect) printf 'failed-architect\n' ;;
    implementer) printf 'failed-implementer\n' ;;
    reviewer) printf 'failed-reviewer\n' ;;
    *) die "unknown role: $1" ;;
  esac
}

role_can_run() {
  local role="$1"
  local status="$2"
  case "$role:$status" in
    architect:new-request) return 0 ;;
    implementer:ready-for-implementation) return 0 ;;
    implementer:changes-requested) return 0 ;;
    reviewer:ready-for-review) return 0 ;;
    *) return 1 ;;
  esac
}

make_prompt() {
  local role="$1"
  cat <<PROMPT
You are the $role in a shared three-agent Copilot workflow.

Project root:
$PROJECT_ROOT

Project workflow directory:
$PROJECT_DIR

Workflow files:
- REQUEST.md: user request
- PLAN.md: architect plan
- IMPLEMENTATION.md: implementer notes
- REVIEW.md: reviewer findings
- STATUS.md: first line is the current workflow status
- LOG.md: generated chronological workflow log
- INDEX.md: generated navigation index
- DASHBOARD.html: generated human-readable visual dashboard

Hard rules:
- Use the workflow files as the source of truth. Do not ask the user to paste task context from another window.
- Do not ask the user to manually run copilot-flow commands. If a workflow command is needed, run it yourself.
- Keep the task scoped to this project.
- Preserve unrelated user changes.
- If blocked or the request is ambiguous, write the blocker into the role output file and run copilot-flow set-status blocked.
- LOG.md, INDEX.md, and DASHBOARD.html are generated by copilot-flow. Read them when useful, but do not edit them directly.
- When changing workflow state, prefer running copilot-flow set-status <status> instead of editing STATUS.md directly. This keeps LOG.md, INDEX.md, and DASHBOARD.html in sync.
- Keep Markdown files as the canonical agent-readable state. Use DASHBOARD.html only as a generated human-readable visual artifact.

Conversational intake:
- The user may submit new work by directly chatting in any role window.
- If the user gives a new top-level task, capture the full request yourself. For a one-line request, run: copilot-flow new "<full user request>"
- For a multi-line request, use a heredoc with the REQUEST terminator at the start of the line:
  copilot-flow new <<'REQUEST'
<full user request>
REQUEST
- If running the command is not appropriate, update REQUEST.md directly, reset PLAN.md, IMPLEMENTATION.md, and REVIEW.md from the workflow templates, and run copilot-flow set-status new-request.
- Distinguish new top-level requests from role-specific feedback. Feedback such as "this implementation is wrong" or "review this edge case" should update the current role's work, not reset the request.

Role-specific instructions:

Architect:
- This role is triggered from new-request. The launcher may already have changed STATUS.md to planning before this prompt starts; proceed if your current role is architect.
- Read REQUEST.md and inspect the codebase as needed.
- Do not modify project source code.
- Write a concrete implementation plan to PLAN.md, including files likely involved, steps, validation, and risks.
- Run copilot-flow set-status ready-for-implementation when the plan is ready.
- If the user gives a new top-level task directly to the Architect, capture it, then immediately continue with planning.

Implementer:
- This role is triggered from ready-for-implementation or changes-requested. The launcher may already have changed STATUS.md to implementing before this prompt starts; proceed if your current role is implementer.
- Read REQUEST.md, PLAN.md, and REVIEW.md if present.
- Implement only the planned or review-requested changes.
- Run the relevant existing validation commands.
- Write IMPLEMENTATION.md with summary, files changed, and validation result.
- Run copilot-flow set-status ready-for-review when implementation is ready.
- If the user gives a new top-level task directly to the Implementer, capture it and run copilot-flow set-status new-request unless the user explicitly asks to bypass planning.

Reviewer:
- This role is triggered from ready-for-review. The launcher may already have changed STATUS.md to reviewing before this prompt starts; proceed if your current role is reviewer.
- Read REQUEST.md, PLAN.md, IMPLEMENTATION.md, and inspect the current git diff.
- Do not modify project source code.
- Write REVIEW.md with only correctness, security, reliability, test coverage, or maintainability findings.
- If there are blocking issues, run copilot-flow set-status changes-requested.
- If there are no blocking issues, run copilot-flow set-status approved.
- If the user gives a new top-level task directly to the Reviewer, capture it and run copilot-flow set-status new-request unless the user is asking for review guidance.

Execute only the responsibilities for your current role: $role.
PROMPT
}

make_interactive_prompt() {
  local role="$1"
  make_prompt "$role"
  cat <<PROMPT

Interactive session rules:
- This is a persistent interactive $role window, not a one-shot automation run.
- On startup, read STATUS.md and the relevant workflow files, then briefly state the current workflow status.
- If the current status is actionable for $role, begin that role's work.
- If the current status is not actionable for $role, stay available for role-specific discussion, corrections, and guidance.
- When the user gives feedback in this window, treat it as an instruction for $role and update the relevant workflow file or project code according to this role's permissions.
- When the user states a new task in plain language, do the workflow intake yourself. The user should not need to run copilot-flow new manually.
- Do not ask the user to paste context from other windows. Re-read REQUEST.md, PLAN.md, IMPLEMENTATION.md, REVIEW.md, STATUS.md, LOG.md, INDEX.md, DASHBOARD.html, and git diff as needed.
- Keep this session interactive after completing a step so the user can continue correcting or discussing the work.
PROMPT
}

start_role() {
  local role="$1"
  ensure_project

  local model prompt flags=()
  model="$(role_model "$role")"
  prompt="$(make_interactive_prompt "$role")"

  if [ -n "$INTERACTIVE_FLAGS" ]; then
    # Intentionally allow splitting so users can provide multiple CLI flags.
    # shellcheck disable=SC2206
    flags=( $INTERACTIVE_FLAGS )
  fi

  printf 'Starting interactive %s for %s with model %s\n' "$role" "$PROJECT_ID" "$model"
  printf 'Workbench: %s\n' "$PROJECT_DIR"
  exec "$COPILOT_BIN" \
    -C "$PROJECT_ROOT" \
    --model "$model" \
    --mode interactive \
    --add-dir "$WORKFLOW_ROOT" \
    -n "workflow-$PROJECT_ID-$role" \
    "${flags[@]}" \
    -i "$prompt"
}

run_role() {
  local role="$1"
  ensure_project

  local status lock model start_status failure_status prompt
  status="$(status_value "$PROJECT_DIR")"
  if ! role_can_run "$role" "$status"; then
    printf '%s is idle for status %s\n' "$role" "$status"
    return 0
  fi

  lock="$PROJECT_DIR/.lock-$role"
  if ! mkdir "$lock" 2>/dev/null; then
    printf '%s is already running for %s\n' "$role" "$PROJECT_ID"
    return 0
  fi

  model="$(role_model "$role")"
  start_status="$(role_start_status "$role")"
  failure_status="$(role_failure_status "$role")"
  prompt="$(make_prompt "$role")"

  set_status "$PROJECT_DIR" "$start_status"
  printf 'Starting %s for %s with model %s\n' "$role" "$PROJECT_ID" "$model"

  local flags=()
  # Intentionally allow splitting so users can override with multiple flags.
  # shellcheck disable=SC2206
  flags=( $COPILOT_FLAGS )

  if ! "$COPILOT_BIN" -C "$PROJECT_ROOT" --model "$model" "${flags[@]}" -p "$prompt"; then
    set_status "$PROJECT_DIR" "$failure_status"
    rmdir "$lock" 2>/dev/null || true
    return 1
  fi

  rmdir "$lock" 2>/dev/null || true
}

watch_role() {
  local role="$1"
  local interval="${2:-$DEFAULT_INTERVAL}"
  printf 'Watching %s every %s seconds\n' "$role" "$interval"
  while true; do
    run_role "$role" || true
    sleep "$interval"
  done
}

status_cmd() {
  ensure_project
  printf 'Project:   %s\n' "$PROJECT_ID"
  printf 'Root:      %s\n' "$PROJECT_ROOT"
  printf 'Workbench: %s\n' "$PROJECT_DIR"
  printf 'Status:    %s\n' "$(status_value "$PROJECT_DIR")"
}

prompts_cmd() {
  cat <<'PROMPTS'
Open three terminal windows in the project directory and run:

  copilot-architect
  copilot-implementer
  copilot-reviewer

Equivalent long form:

  copilot-flow start architect
  copilot-flow start implementer
  copilot-flow start reviewer

Then submit work by chatting directly in any role window. Scripted intake is also available:

  copilot-flow new "Describe the task here."
PROMPTS
}

case "$(basename "$0")" in
  copilot-architect)
    set -- start architect "$@"
    ;;
  copilot-implementer)
    set -- start implementer "$@"
    ;;
  copilot-reviewer)
    set -- start reviewer "$@"
    ;;
esac

cmd="${1:-help}"
shift || true

case "$cmd" in
  init)
    ensure_project
    status_cmd
    ;;
  new)
    new_request "$@"
    ;;
  status)
    status_cmd
    ;;
  set-status)
    [ $# -eq 1 ] || die "usage: copilot-flow set-status <status>"
    ensure_project
    set_status "$PROJECT_DIR" "$1"
    status_cmd
    ;;
  refresh|dashboard)
    ensure_project
    refresh_generated "$PROJECT_DIR"
    printf 'Refreshed generated workflow files for %s\n' "$PROJECT_ID"
    printf 'Dashboard: %s\n' "$PROJECT_DIR/DASHBOARD.html"
    ;;
  where)
    ensure_project
    printf '%s\n' "$PROJECT_DIR"
    ;;
  start)
    [ $# -eq 1 ] || die "usage: copilot-flow start <architect|implementer|reviewer>"
    start_role "$1"
    ;;
  run)
    [ $# -eq 1 ] || die "usage: copilot-flow run <architect|implementer|reviewer>"
    run_role "$1"
    ;;
  watch)
    [ $# -ge 1 ] || die "usage: copilot-flow watch <architect|implementer|reviewer> [seconds]"
    watch_role "$1" "${2:-$DEFAULT_INTERVAL}"
    ;;
  prompts)
    prompts_cmd
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    usage
    exit 1
    ;;
esac
